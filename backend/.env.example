# Copy to your shell / Render environment. All optional for local use.
# Supabase project URL (enables JWKS verification of access tokens)
SUPABASE_URL=
# Legacy HS256 JWT secret (Project Settings -> API -> JWT secret), if your project uses it
SUPABASE_JWT_SECRET=
# Reject unauthenticated requests (default false: guests can simulate)
REQUIRE_AUTH=false
# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Safety limits per simulation
MAX_NEURONS=5000
MAX_STEPS=20000
MAX_SYNAPSES=4000000
MAX_CONCURRENT=2
