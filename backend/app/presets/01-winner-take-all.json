{
  "id": "winner-take-all",
  "title": "Winner-Take-All circuit",
  "tags": [
    "competition",
    "lateral inhibition",
    "decision making"
  ],
  "references": [
    "Douglas & Martin (2004) Neuronal circuits of the neocortex. Annu. Rev. Neurosci.",
    "Maass (2000) On the computational power of winner-take-all. Neural Computation."
  ],
  "network": {
    "version": 1,
    "name": "Winner-Take-All circuit",
    "description": "Three excitatory groups receive stimuli of different strength and all excite one shared pool of inhibitory neurons, which inhibits every group in return. The group with the strongest input fires first, recruits inhibition and silences its competitors: the network computes an argmax with spikes.",
    "biology": "Soft winner-take-all motifs built from recurrent excitation and pooled inhibition are found throughout neocortex (e.g. between orientation columns and in attention/decision circuits). They let a population select the most salient input and suppress the rest. Inhibitory basket cells provide the shared pool.",
    "sim": {
      "dt": 0.1,
      "duration": 1000,
      "seed": 7,
      "record_per_population": 4,
      "chunk_ms": 25
    },
    "populations": [
      {
        "id": "e_a",
        "label": "Excitatory A",
        "count": 30,
        "model": "lif",
        "params": {
          "tau_m": 20,
          "v_rest": -65,
          "v_reset": -70,
          "v_th": -50,
          "t_ref": 2,
          "tau_syn": 5,
