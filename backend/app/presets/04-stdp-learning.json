{
  "id": "stdp-learning",
  "title": "STDP learning demo",
  "tags": [
    "plasticity",
    "Hebbian learning",
    "unsupervised"
  ],
  "references": [
    "Bi & Poo (1998) Synaptic modifications in cultured hippocampal neurons. J. Neurosci.",
    "Song, Miller & Abbott (2000) Competitive Hebbian learning through STDP. Nat. Neurosci.",
    "Masquelier, Guyonneau & Thorpe (2008) Spike timing dependent plasticity finds the start of repeating patterns. PLoS ONE."
  ],
  "network": {
    "version": 1,
    "name": "STDP learning demo",
    "description": "Ten output neurons receive two groups of afferents that fire at exactly the same average rate (20 Hz). One group fires in near-synchronous volleys every 50 ms; the other is random. Spike-timing dependent plasticity strengthens the synapses whose spikes reliably arrive just before the output fires, so the correlated synapses grow while the random ones weaken: the neuron learns which inputs belong together, without a teacher.",
    "biology": "In real synapses, a presynaptic spike arriving a few ms before the postsynaptic spike causes long-term potentiation, and the reverse order causes depression (Bi & Poo 1998). This 'fire together, wire together' rule with a causal twist lets neurons detect repeating spatiotemporal patterns and is a leading candidate for unsupervised learning in cortex.",
    "sim": {
      "dt": 0.2,
      "duration": 3000,
      "seed": 5,
      "record_per_population": 3,
      "chunk_ms": 50
    },
    "populations": [
      {
        "id": "out",
        "label": "Output neurons",
        "count": 10,
        "model": "lif",
        "params": {
          "tau_m": 20,
          "v_rest": -65,
          "v_reset": -70,
          "v_th": -50,
          "t_ref": 5,
          "tau_syn": 5,
          "bias": 0,
          "noise": 0,
          "adapt_b": 0,
          "tau_w": 100
        },
        "position": {
