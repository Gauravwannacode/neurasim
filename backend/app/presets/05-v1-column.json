{
  "id": "v1-column",
  "title": "Visual cortex V1 column",
  "tags": [
    "cortex",
    "laminar",
    "Izhikevich",
    "feedforward"
  ],
  "references": [
    "Douglas & Martin (1991, 2004) canonical microcircuit of neocortex.",
    "Izhikevich (2003) Simple model of spiking neurons. IEEE Trans. Neural Networks.",
    "Potjans & Diesmann (2014) The cell-type specific cortical microcircuit. Cereb. Cortex."
  ],
  "network": {
    "version": 1,
    "name": "Visual cortex V1 column",
    "description": "A simplified cortical column with three layers, each with excitatory and fast-spiking inhibitory Izhikevich neurons. A burst of thalamic (LGN) input from 100–600 ms arrives in layer 4, is relayed to layers 2/3 and then to the bursting pyramidal cells of layer 5, the column's output. Watch activity sweep through the layers with a few ms delay each.",
    "biology": "Primary visual cortex is organised into columns whose layers follow the 'canonical microcircuit' (Douglas & Martin): thalamus → L4 → L2/3 → L5/6, with local inhibition balancing excitation in every layer. Different cell types are captured by Izhikevich's model: regular-spiking (RS) and intrinsically-bursting (IB) pyramidal cells and fast-spiking (FS) basket cells.",
    "sim": {
      "dt": 0.1,
      "duration": 800,
      "seed": 1,
      "record_per_population": 4,
      "chunk_ms": 20
    },
    "populations": [
      {
        "id": "l23e",
        "label": "L2/3 pyramidal (RS)",
        "count": 120,
        "model": "izhikevich",
        "params": {
          "v_th": 30,
          "t_ref": 0,
          "tau_syn": 5,
          "bias": 0,
          "noise": 3.0,
          "a": 0.02,
          "b": 0.2,
          "c": -65,
          "d": 8
        },
        "position": {
          "x": 360,
          "y": 0
        }
      },
      {
